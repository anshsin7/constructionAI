# Classify results: AI relevance % (display only, not stored)
RELEVANCE_MIN_PERCENT=50
RELEVANCE_CANDIDATE_LIMIT=28
RELEVANCE_DISPLAY_LIMIT=15
RELEVANCE_MODEL=gpt-4o-mini
